# Copy this file to .env (in the folder you run guardian from) and fill in what you have.
# Everything is optional:
# with nothing set, Guardian still works in "paste comments" + offline mode.

# Smarter, context-aware sorting (understands sarcasm, misspelled insults).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube: free key from Google Cloud Console -> enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Instagram: Graph API token for a Business or Creator account
INSTAGRAM_ACCESS_TOKEN=

# X: bearer token from developer.x.com (Basic tier or higher can read replies)
X_BEARER_TOKEN=

# TikTok: nothing needed - paste or upload your comments.

# ---------------------------------------------------------------------------
# Hide bullying ON the platform (not just in the app)
# YouTube: OAuth client from Google Cloud Console (see README), then click
# "Connect YouTube" in the app. Instagram uses INSTAGRAM_ACCESS_TOKEN above.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Weekly kindness email (guardian-weekly-report)
# Posts to watch, comma separated, as platform:link (youtube, instagram or x)
WATCH_POSTS=youtube:https://www.youtube.com/watch?v=VIDEO_ID
# true = also hide bullying on the platform each week (YouTube/Instagram)
AUTO_HIDE=false
# Where to send it. Gmail: smtp.gmail.com + an "App password" (not your normal password)
REPORT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Always-on protection: hides bullying automatically, around the clock (on by default)
# Set ALWAYS_ON=off to turn it off when running the guardian app
ALWAYS_ON=on
# X: hiding replies needs an X login. Create an app at developer.x.com with
# OAuth 2.0 turned on, callback http://localhost:5000/auth/x/callback, then click
# "Connect X" in the app. X_CLIENT_SECRET only if your app type has one.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional: your Instagram account ID (found automatically if left empty)
INSTAGRAM_USER_ID=
